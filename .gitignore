# ============================================================================
# Camp Card - Root .gitignore
# ============================================================================

# ==== IDE ====
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==== Environment & Secrets ====
.env
.env.local
.env.*.local
.env.aws
*.pem
*.key
secrets/
.aws/

# ==== Firebase/Google Credentials (use EAS Secrets or GitHub Secrets) ====
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
google-service-account.json

# ==== Duplicate root config files (use mobile/ versions) ====
/app.json
/eas.json

# ==== Node.js ====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==== Java/Maven ====
target/
*.jar
*.war
*.ear
*.class
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==== Python ====
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/

# ==== Build outputs ====
dist/
build/
out/
.next/
*.tgz

# ==== Logs ====
logs/
*.log
npm-debug.log*

# ==== Docker ====
docker-compose.override.yml

# ==== Terraform ====
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# ==== Testing ====
coverage/
.nyc_output/
*.lcov

# ==== OS generated ====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Append these lines to the target repo's .gitignore.
# If the repo has no .gitignore yet, copy this file's contents into a new .gitignore.

# Claude Code internals — local-only files that MUST NOT be committed.
# - `settings.local.json` is per-developer permission overrides (Anthropic convention).
# - `CLAUDE.local.md` is project-specific notes for one dev only.
# - `memory/` contains auto-memory — personal to each dev.
# - `scheduled_tasks*.lock` is runtime scheduler state.
.claude/scheduled_tasks*.lock
.claude/settings.local.json
.claude/memory/
CLAUDE.local.md

# macOS metadata
.DS_Store

# Keys & credentials
keys/
**/keys/
credentials.json
**/credentials.json
*.p8
*.pem
*.key
*.jks
*.p12

# Terraform variables (often contain secrets)
*.tfvars
!*.tfvars.example
terraform.tfvars.local
