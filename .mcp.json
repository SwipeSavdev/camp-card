{
  "$schema": "https://json.schemastore.org/mcp-config",
  "_comment": "Project-scoped MCP servers. Each dev approves on first session. Credentials come from each dev's shell env — not stored in this file. Run `gh auth login` for GITHUB_TOKEN, create a Sentry user auth token for SENTRY_AUTH_TOKEN, run `aws sso login` for AWS_PROFILE.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "swipe-savvy"
      }
    },
    "aws-cloudwatch": {
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "${AWS_PROFILE:-default}"
      }
    }
  }
}
